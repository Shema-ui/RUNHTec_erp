# Full URL of the PocketBase backend, no trailing slash.
# Required for any deployment outside Hostinger Horizons hosting
# (e.g. app.runhteccontractors.com talking to api.runhteccontractors.com).
# Leave unset only if you are relying on the Horizons '/hcgi/platform' rewrite.
VITE_POCKETBASE_URL=https://api.runhteccontractors.com
