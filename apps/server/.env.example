# MySQL connection — on Hostinger this is the database you create in
# hPanel -> Databases -> MySQL Databases. Host is almost always "localhost"
# when the Node app and MySQL are on the same Hostinger account.
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Generate once, keep secret, never commit. Example: openssl rand -hex 32
JWT_SECRET=

# Comma-separated list of frontend origins allowed to call this API, e.g.
# https://erp.runhteccontractors.si
# Leave empty during local development to allow any origin.
CORS_ORIGINS=

# Used to build links in password-reset emails.
APP_URL=https://erp.runhteccontractors.si

PORT=8090
