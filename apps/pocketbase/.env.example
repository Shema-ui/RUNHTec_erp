# Required at runtime — export before `npm run start` / `./pocketbase serve`.
# Generate ONCE per environment and store in a secrets manager; losing it
# after data has been encrypted with it makes those values unrecoverable.
# Must be 32 bytes. Example generation: openssl rand -hex 16
PB_ENCRYPTION_KEY=

# Superuser bootstrap is deliberately NOT handled via env var or committed
# migration (see .gitignore). After the server is running for the first
# time, create the admin account with:
#   ./pocketbase superuser upsert you@runhteccontractors.com "<strong-password>" \
#     --encryptionEnv=PB_ENCRYPTION_KEY --dir=./pb_data
